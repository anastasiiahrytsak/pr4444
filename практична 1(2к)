function task8(arr1, arr2) {
    let sum1 = 0;
    for (let i = 0; i < arr1.length; i++) sum1 += arr1[i];
    let avg1 = sum1 / arr1.length;


    let sum2 = 0;
    for (let i = 0; i < arr2.length; i++) sum2 += arr2[i];
    let avg2 = sum2 / arr2.length;


    let minAvg = Math.min(avg1, avg2);
    let maxAvg = Math.max(avg1, avg2);

    let result = [];
    
 
    let allElements = arr1.concat(arr2);

    for (let i = 0; i < allElements.length; i++) {
        if (allElements[i] >= minAvg && allElements[i] <= maxAvg) {
            result.push(allElements[i]);
        }
    }

    console.log(`8. Елементи між середніми (${avg1.toFixed(2)} і ${avg2.toFixed(2)}):`, result);
}
