function task7(arr) {
  
    let max = arr[0];
    let min = arr[0];
    for (let i = 1; i < arr.length; i++) {
        if (arr[i] > max) max = arr[i];
        if (arr[i] < min) min = arr[i];
    }

    let result = [];
    let foundMax = false;
    let foundMin = false;

    for (let i = 0; i < arr.length; i++) {
        if (arr[i] === max) {
            if (!foundMax) {
                result.push(arr[i]);
                foundMax = true; 
            }
        } else if (arr[i] === min) {
            if (!foundMin) {
                result.push(arr[i]);
                foundMin = true; 
            }
        } else {
            result.push(arr[i]);
        }
    }
    console.log("7. Масив без дублікатів Max/Min:", result);
}
