function generateRandomArray(size, min, max) {
    let arr = [];
    for (let i = 0; i < size; i++) {
        let num = Math.floor(Math.random() * (max - min + 1)) + min;
        arr.push(num);
    }
    return arr;
}


let myArray = generateRandomArray(10, -10, 10);
console.log("Початковий масив:", myArray);


function task1(arr, startIndex, endIndex) {
    let count = 0;
    let sum = 0;

    for (let i = startIndex; i <= endIndex; i++) {
      
        if (i < arr.length && arr[i] % 2 === 0) {
            count++;
            sum += arr[i];
        }
    }
    console.log(`1. У діапазоні від ${startIndex} до ${endIndex}: кількість парних = ${count}, сума = ${sum}`);
}
task1(myArray, 2, 7);


function task2(arr) {
    let sum = 0;
    for (let i = 0; i < arr.length; i++) {
        sum += arr[i];
    }
    let avg = sum / arr.length;

    let count = 0;
    for (let i = 0; i < arr.length; i++) {
        if (arr[i] > avg) {
            count++;
        }
    }
