function task5(arr) {
  
    let copy = arr.slice();
    
    let maxIndex = 0;
    let minIndex = 0;

    for (let i = 1; i < copy.length; i++) {
        if (copy[i] > copy[maxIndex]) {
            maxIndex = i;
        }
        if (copy[i] < copy[minIndex]) {
            minIndex = i;
        }
    }

   
    let temp = copy[maxIndex];
    copy[maxIndex] = copy[minIndex];
    copy[minIndex] = temp;

    console.log("5. Масив після обміну Max та Min:", copy);
}
